@echo off
title freeEngine Host Launcher
echo ========================================================
echo   freeEngine Host (freeengine.acess)
echo   Initializing Electron Chromium-WebGPU Runtime...
echo ========================================================
set "NODE_ENV=production"
"%~dp0node_modules\.bin\electron.cmd" "%~dp0src\electron\main.cjs" %*
if %ERRORLEVEL% NEQ 0 (
  node "%~dp0node_modules\electron\cli.js" "%~dp0src\electron\main.cjs" %*
)
